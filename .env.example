OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5
# Opcional se a chave pertence a org/projeto especifico (evita 401 Not authorized)
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
# Admin API key (sk-admin-…) — só para custos MTD / spend limit no painel Admin → Provedores
OPENAI_ADMIN_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
EVAL_JUDGE_ENABLED=false
EVAL_JUDGE_PROVIDER=
EVAL_JUDGE_MODEL=

# Firebase Auth (login)
# AUTH_DOMAIN deve ser <project-id>.firebaseapp.com (nao a URL da Vercel).
# Google login: Firebase → Authentication → Sign-in method → Google (habilitado).
# Google Cloud → Credentials → Web client (auto created by Firebase) → Authorized redirect URIs:
#   https://<project-id>.firebaseapp.com/__/auth/handler
#   https://<project-id>.web.app/__/auth/handler
# Firebase → Authentication → Settings → Authorized domains: localhost, madatodigital.web.app, madatodigital.firebaseapp.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# JSON completo da service account (Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Storage (treino/vídeo/compliance) — default = NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
# FIREBASE_TRAINING_ASSETS_BUCKET=

# HeyGen (Curador v2 — avatar, voz, video)
HEYGEN_API_KEY=
HEYGEN_BASE_URL=https://api.heygen.com
# Voz do Criativo: elevenlabs_audio (TTS→audio_url) | heygen_clone (legado, limite ~10)
HEYGEN_VOICE_PROVIDER=elevenlabs_audio
# Em dev, permite trocar a API key pelo painel oculto do Distribuidor (triplo clique no topo).
# Em producao/staging, defina true apenas se precisar testar outra conta sem redeploy.
HEYGEN_ALLOW_CLIENT_KEY_OVERRIDE=

# ElevenLabs (clone IVC + TTS; conta unica da plataforma)
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TTS_MODEL_ID=eleven_v3
# ELEVENLABS_TTS_LANGUAGE_CODE=pt
# ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
# Creator+: mp3_44100_192
# Semaforo global de IVC efemero (default 1 — respeita cota de custom voices)
# ELEVENLABS_IVC_MAX_CONCURRENT=1

# Sentinela (Fase 1 — flags opcionais)
# SENTINEL_V2_PIPELINES=true
# SENTINEL_LLM_EXPANSION=true
# SENTINEL_LLM_THEME_VERIFY=true
# Spike qualidade: LLM mini no top N (ligado em apphosting; ver docs/spike-sentinela-qualidade.md)
# SENTINEL_LLM_QUALITY_RANK=true
# E2E / Sentinela (Playwright) — ver docs/e2e-sentinela.md
# E2E_EMAIL=
# E2E_PASSWORD=
# SENTINEL_E2E_REFRESH=1
# SENTINEL_TREND_PROXY=true
# SENTINEL_SOCIAL_ENABLED=false
# SENTINEL_SERPAPI_KEY=
# Adversarios: ultimos posts do Instagram via Apify (requer flag + token)
# SENTINEL_SOCIAL_ENABLED=true
# APIFY_TOKEN=
# APIFY_API_TOKEN=
# APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper

# Validador / Fase 2 (flags off em producao ate validacao)
# AUDITOR_FACTCHECK_ENABLED=true

# URL publica do app (HTTPS): treino (assets) + webhook HeyGen (/api/heygen/webhooks)
APP_BASE_URL=
NEXT_PUBLIC_APP_BASE_URL=
TRAINING_ASSET_ACCESS_SECRET=

# Compliance / contrato (1ª leva)
# Resend: envio do Contrato + Dossiê após aceite do CNPJ (sem NF nesta fase)
RESEND_API_KEY=
# Temporario: Thiago. Obs: Resend exige dominio verificado no FROM —
# Gmail costuma falhar como remetente ate haver dominio proprio.
EMAIL_FROM=Mandato Digital <tribeiro81@gmail.com>
EMAIL_INTERNAL_COPY=tribeiro81@gmail.com

# Painel de gestão (/admin) — acesso via flag isAdmin no cadastro do usuário
# (node scripts/set-admin-flag.mjs email@exemplo.com), sem senha compartilhada.
# ADMIN_SESSION_SECRET só deriva a chave de criptografia do cofre de provider secrets.
# Em App Hosting: cadastre via npm run firebase:secrets:apply (admin-session-secret)
# Sem secret, o default de bootstrap ainda funciona (com warning nos logs).
# ADMIN_SESSION_SECRET=

# Async jobs (selo FFmpeg / voice TTS) — ver docs/adr-async-jobs-pubsub.md
# ASYNC_SEAL_ENABLED=true
# NEXT_PUBLIC_ASYNC_SEAL_ENABLED=true
# ASYNC_VOICE_ENABLED=true
# NEXT_PUBLIC_ASYNC_VOICE_ENABLED=true
# PUBSUB_JOBS_ENABLED=false
# PUBSUB_TOPIC_SEAL=md-jobs-seal
# PUBSUB_TOPIC_VOICE=md-jobs-voice
# JOBS_WORKER_SHARED_SECRET=
# JOBS_WORKER_OIDC_AUDIENCE=

# Distribuidor (Instagram Graph — Reels). Fail-closed ate smoke.
# DISTRIBUTION_ENABLED=false
# NEXT_PUBLIC_DISTRIBUTION_ENABLED=false
# DISTRIBUTION_PUBLISH_ENABLED=false
# NEXT_PUBLIC_DISTRIBUTION_PUBLISH_ENABLED=false
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=https://mandatodigital--madatodigital.us-central1.hosted.app/api/distribution/instagram/callback
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_IG_USER_ID=
# INSTAGRAM_USERNAME=
# INSTAGRAM_ALLOW_ENV_TOKEN=true
# PUBSUB_TOPIC_PUBLISH=md-jobs-publish

# Asaas (PIX + boleto — pacote campanha 3x). Nunca commitar a API key.
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_API_URL=https://api.asaas.com/v3

# NFS-e automática (off até conta fiscal + serviço municipal prontos no painel Asaas)
# ASAAS_NFS_ENABLED=false
# ASAAS_NFS_MUNICIPAL_SERVICE_ID=
# ASAAS_NFS_MUNICIPAL_SERVICE_CODE=
# ASAAS_NFS_MUNICIPAL_SERVICE_NAME=
# ASAAS_NFS_ISS=
# ASAAS_NFS_RETAIN_ISS=false
# ASAAS_NFS_COFINS=0
# ASAAS_NFS_CSLL=0
# ASAAS_NFS_INSS=0
# ASAAS_NFS_IR=0
# ASAAS_NFS_PIS=0


# WhatsApp Cloud API (outbound do /admin/marketing) — ver docs/marketing-outbound.md
# Meta → App → WhatsApp → Configuração da API: "ID do número de telefone"
WHATSAPP_PHONE_NUMBER_ID=
# Token de system user (permanente). O temporário de 24h só serve para teste.
WHATSAPP_ACCESS_TOKEN=
# Você escolhe esta string e repete no painel do Meta ao cadastrar o webhook.
WHATSAPP_VERIFY_TOKEN=
# Meta → App → Configurações → Básico → "Chave secreta do aplicativo".
# Sem isso o webhook recusa tudo (não dá para provar que a chamada veio da Meta).
WHATSAPP_APP_SECRET=
# Opcional: só muda se precisar fixar outra versão da Graph API.
# WHATSAPP_GRAPH_VERSION=v25.0
# Link do material prometido nos templates. Enquanto vazio, a IA não promete link.
WHATSAPP_DEMO_LINK_URL=
